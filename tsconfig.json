{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "strict": true,
    "noEmit": true,
    // Nothing is emitted, so tests may import docs/.vitepress/config.mts by
    // its real name; without the extension the config cannot be resolved.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "docs/**/*.ts",
    "docs/**/*.mts",
    "docs/**/*.vue",
    "test/**/*.ts",
    "vitest.config.ts",
    // Listed explicitly: `include` globs skip dot-directories, so
    // docs/**/*.mts alone leaves the VitePress config unchecked.
    "docs/.vitepress/config.mts"
  ],
  "exclude": [
    "node_modules",
    "docs/.vitepress/dist",
    "docs/.vitepress/cache"
  ]
}
